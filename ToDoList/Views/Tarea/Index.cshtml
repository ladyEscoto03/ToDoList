@model IEnumerable<ToDoList.Models.Tarea>

<button type="button"
        class="btn btn-primary"
        onclick="openModal('#CrearModal')">
    Crear tarea
</button>

<div class="modal fade" id="CrearModal" tabindex="-1" role="dialog" aria-labelledby="CrearModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CrearModalLabel">Crear una nueva tarea</h5>
                <button type="button" class="close btn btn-close" data-dismiss="modal" aria-label="Close" onclick="closeModal('#CrearModal')" >
                    
                </button>
            </div>
            <div class="modal-body m-auto">
                <form id="createForm">
                    <div class="form-group">
                        <label for="title" class="col-form-label">Ingresa título de la tarea</label>
                        <input type="text" class="form-control" id="title">
                    </div>
                    <div class="form-group">
                        <label for="description" class="col-form-label">Ingresa una breve descripción</label>
                        <textarea class="form-control" id="description" cols="35" rows="6"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="deadline" class="col-form-label">Seleccione la fecha límite para hacer la tarea</label>
                        <input type="date" class="form-control" id="deadline">
                    </div>
                    <div class="form-group">
                        <label for="priority" class="col-form-label">Seleccione la fecha límite para hacer la tarea</label>
                        <select class="form-select" aria-label="Default select example" id="priority">
                            <option selected>Seleccione una opción</option>
                            <option value="Alta">Alta</option>
                            <option value="Media">Media</option>
                            <option value="Baja">Baja</option>
                        </select>
                    </div>

                </form>
            </div>
            <div class="modal-footer d-flex justify-content-between">

                <button type="button" class="btn btn-primary" onclick="crearTarea()">Registrar</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="closeModal('#CrearModal')">Cancelar</button>
            </div>
        </div>
    </div>
</div>





<div class="modal fade" id="EditarModal" tabindex="-1" role="dialog" aria-labelledby="EditarModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="EditarModalLabel">Editar tarea</h5>
                <button type="button" class="close btn btn-close" data-dismiss="modal" aria-label="Close" onclick="closeModal('#EditarModal')">
                </button>
            </div>
            <div class="modal-body m-auto">
                <form id="createForm">
                    <div class="form-group">
                        <label for="edit_id" class="col-form-label">Id de tarea</label>
                        <input type="text" class="form-control" id="edit_id" disabled>
                    </div>
                    <div class="form-group">
                        <label for="edit_title" class="col-form-label">Título de la tarea</label>
                        <input type="text" class="form-control" id="edit_title">
                    </div>
                    <div class="form-group">
                        <label for="edit_description" class="col-form-label">Descripción breve de la tarea</label>
                        <textarea class="form-control" id="edit_description" cols="35" rows="6"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="edit_deadline" class="col-form-label">Fecha límite</label>
                        <input type="date" class="form-control" id="edit_deadline">
                    </div>
                    <div class="form-group">
                        <label for="edit_status" class="col-form-label">Estado de la tarea </label>
                        <select class="form-select" aria-label="Default select example" id="edit_status">
                            <option value="Completa">Completa</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="edit_priority" class="col-form-label">Prioridad de la tarea</label>
                        <select class="form-select" aria-label="Default select example" id="edit_priority">
                            <option value="Alta">Alta</option>
                            <option value="Media">Media</option>
                            <option value="Baja">Baja</option>
                        </select>
                    </div>

                </form>
            </div>
            <div class="modal-footer d-flex justify-content-between">

                <button type="button" class="btn btn-primary" onclick="editarTarea()">Editar</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="closeModal('#EditarModal')">Cancelar</button>
            </div>
        </div>
    </div>
</div>


<table class="table">
    <thead>
        <tr>

            <th>Id</th>
            <th>Titulo</th>
            <th>Descripcion</th>
            <th>Fecha creación</th>
            <th>Fecha límite</th>
            <th>Estado</th>
            <th>Prioridad</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody id="tablaTareas">
    </tbody>
</table>

@section scripts{


    <script>
        function openModal(modal) {
            $(modal).modal('show');
        }
        function closeModal(modal) {
            $(modal).modal('hide');
        }

        $(document).ready(function () {
            cargarTareas();
        });



         function cargarTareas() {
     $.ajax({
         type: "GET",
         url: "@Url.Action("GetTareas", "Tarea")",
         dataType: "json",
         success: function (result) {
             let filas = "";
             $.each(result, function (i, item) {
                 filas += `
                 <tr>
                  <td>${item.Id}</td>
                 <td>${item.Title ?? ""}</td>
                 <td>${item.Description ?? ""}</td>
                 <td>${item.Created_at ?? ""}</td>
                 <td>${item.DeadLine ?? ""}</td>
                 <td>${item.Status ?? ""}</td>
                 <td>${item.Priority ?? ""}</td>
                 <td>
                 <button type="button"
        class="btn btn-info" onclick="openModal('#EditarModal'); buscarTarea(${item.Id});" ><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
  <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
</svg></button>
                 <button type="button"
class="btn btn-danger"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
  <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
</svg></button>
                 </td>
                 </tr>`;
             });
             $("#tablaTareas").html(filas);
         },
         error: function (xhr, status, error) {
             console.error("Error al cargar tareas - index:", error);
         }
     });
        }

        function crearTarea() {
     $.ajax({
         type: "POST",
         url: "@Url.Action("Create", "Tarea")",
         dataType: "json",
         data: {
             title: $("#title").val(),
             description: $("#description").val(),
             deadline: $("#deadline").val(),
             priority: $("#priority").val()

         },
         success: function(result) {
             closeModal("#CrearModal");
             cargarTareas();
             $("#createForm")[0].reset();

         },
         error: function (xhr, status, error) {
             console.error("Error al cargar tareas - create:", error);
         }
     })
 }



        function buscarTarea(id) {
            $.ajax({
                type: "GET",
                url: "@Url.Action("SearchTarea", "Tarea")",
                dataType: "json",
                data: {
                    id: id
                },
                success: function(result) {
                    llenarForm(result);
                 
                },
                error: function (xhr, status, error) {
                    console.error("Error al cargar tareas - buscar:", error, " ", xhr);
                }

            })
        }
        function llenarForm(tarea) {
            $("#edit_id").val(tarea.Id);
            $("#edit_title").val(tarea.Title ?? "");
            $("#edit_description").val(tarea.Description ?? "");
            $("#edit_status").val(tarea.Status);
            $("#edit_priority").val(tarea.Priority);
            $("#edit_deadline").val(tarea.DeadLine);
        }

        function editarTarea() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("Edit", "Tarea")",
                dataType: "json",
                data: {
                    id: $("#edit_id").val(),
                    title: $("#edit_title").val(),
                    deadline: $("#edit_deadline").val(),
                    priority: $("#edit_priority").val(),
                    status: $("#edit_status").val(),

                },
                success: function(result) {
                    closeModal("#EditarModal");
                    cargarTareas();
                
                },
                error: function (xhr, status, error) {
                    console.error("Error al cargar tareas - create:", error);
                }
            })
        }

    </script>

}

