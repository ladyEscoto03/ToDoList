@model IEnumerable<ToDoList.Models.Tarea>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Created_at</th>
            <th>DeadLine</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody id="tablaTareas">
       
    </tbody>
</table>

@section scripts{


    <script>
        $(document).ready(function () {

            cargarTareas();


            function cargarTareas() {
                $.ajax({
                    url: "@Url.Action("getTareas", "Tarea")",
                    type: "GET",
                    dataType: "json",
                    success: function (result) {
                        let filas = "";
                        $.each(result, function (i, item) {
                            filas += `
                            <tr>
                            <td>${item.Title ?? ""}</td>
                            <td>${item.Description ?? ""}</td>
                            <td>${item.Created_at ?? ""}</td>
                            <td>${item.DeadLine ?? ""}</td>
                            <td>${item.Status ?? ""}</td>
                            <td>${item.Priority ?? ""}</td>
                            <td>
                            <a href="/Tarea/Edit/${item.Id}">Editar</a>
                            </td>
                            </tr>`;
                        });
                        $("#tablaTareas").html(filas);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error al cargar tareas:", error);
                    }
                });
            }
        });
    </script>

}

